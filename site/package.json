{
  "name": "hashhash-books-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare-content": "node scripts/build-content.mjs",
    "dev": "npm run prepare-content && vitepress dev",
    "lint": "node scripts/lint-content.mjs",
    "fix": "node scripts/fix-content.mjs --write",
    "check": "node scripts/check-pages.mjs",
    "build": "npm run prepare-content && npm run check && vitepress build",
    "preview": "vitepress preview"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "mermaid": "^12.3.0",
    "pdfjs-dist": "^6.5.438"
  }
}
