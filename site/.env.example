# Copy to `.env` to override site/site.config.json. Every variable is optional.

# Public URL prefix. "/" for a custom domain or user site, "/<repo>/" for GitHub project pages.
SITE_BASE=/hashhash-books/

# GitHub repo + branch the files are linked from (raw PDFs, "Edit this page").
SITE_REPO=zouari-oss/hashhash-books
SITE_BRANCH=main

# Site metadata
# SITE_TITLE=HashHashBooks
# SITE_DESCRIPTION=A curated collection of programming books and notes

# Folder scanned for guides/books (relative to site/)
# CONTENT_DIR=../content

# true: one PDF.js preview page per PDF. false: PDFs are only linked (faster build, smaller dist).
PDF_PREVIEW=true

# Host streaming PDFs to the viewer (must allow CORS)
# PDF_STREAM_HOST=https://raw.githubusercontent.com

# Local full-text search
SITE_SEARCH=true
